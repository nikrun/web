{
  "name": "nikrun-web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Nikrun website and documentation (VitePress)",
  "type": "module",
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync-brand",
    "dev": "vitepress dev",
    "prebuild": "npm run sync-brand",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "clean": "node -e \"const fs=require('fs'); for (const d of ['.vitepress/dist', '.vitepress/cache']) if(fs.existsSync(d)) fs.rmSync(d, {recursive:true, force:true});\""
  },
  "devDependencies": {
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  }
}
